# Supabase project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=

# Publishable key (or legacy anon key); used only for Supabase Auth client operations.
SUPABASE_PUBLISHABLE_KEY=

# Server-only service_role/secret key. NEVER expose this to GitHub Pages.
SUPABASE_SERVICE_ROLE_KEY=

# Exact browser origins separated by commas.
ALLOWED_ORIGINS=https://fuguangji.github.io

# Optional; defaults to production.
NODE_ENV=production
PORT=10000
