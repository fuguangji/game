# Firebase Admin SDK service account JSON (server-only).
# Paste the full JSON value into Render as one environment variable.
# Leave empty for local checks; authenticated endpoints return 503 until configured.
# NEVER commit the actual service-account JSON.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Exact browser origins separated by commas.
ALLOWED_ORIGINS=https://fuguangji.github.io

# Optional; defaults to production.
NODE_ENV=production
PORT=10000
